[node name="tutorialMarkPrelude" parent="." instance=ExtResource("2_k3c6j")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 72.0
video_file = "res://graphics/system-map/tutorial/tutorialMarkPrelude.ogv"
flash_switch_button_until_pressed = true
target_objective_wID = "tutorialMarkPrelude"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/scopes_snap_scroll/core_and_value_scroll/core/core_scroll/core_panel/core_margin/core_scroll/sonar_container")
track_offset = Vector2(0, -275)
info = "Firstly, let's mark a body named Prelude. Marking a body establishes its location on the SYSTEM LIST and is [color=yellow][b]usually[/b] required[/color] before [color=yellow]discovery[/color]. A body can be marked by [color=yellow]pinging it three times[/color].

To ping Prelude, adjust the LIDAR direction with left click [[img=2em2em]graphics/shared/mouse/mouse_left.png[/img]] so it points towards the red circle, set the arc to max with the slider, and press the ‘PING!’ button.
[img=75%x75%]res://graphics/objective/tutorial_LIDAR_example.png[/img]"

[node name="tutorialOptionalScopeMode" parent="." instance=ExtResource("1_fpin1")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 66.0
target_objective_wID = "tutorialOptionalScopeMode"
text_box_size = Vector2(250, 100)
track = NodePath("../../control/scopes_snap_scroll/scopes_bg/scopes_margin/scopes_container")
track_offset = Vector2(-307, 0)
info = "Press the 'RAD' button on SCOPES or $SC_SCOPE_SWITCH to switch the scope mode. Depending on the scope mode, different kinds of bodies can be discovered."

[node name="tutorialOptionalZoomScopes" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialOptionalZoomScopes"
track = NodePath("../../control/scopes_snap_scroll/scopes_bg/scopes_margin/scopes_container")
track_offset = Vector2(0, -225)
info = "Left click [[img=2em2em]graphics/shared/mouse/mouse_left.png[/img]] and drag up or down (or scroll [[img=2em2em]graphics/shared/mouse/mouse_scroll.png[/img]]) on SCOPES to zoom in or out. [color=yellow]Zooming in allows bodies to be seen up close sooner[/color]."

[node name="tutorialDiscoverPrelude" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialDiscoverPrelude"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/tabs_and_ca_scroll/tabs_actions_scroll/actions_panel")
track_offset = Vector2(0, -300)
info = "Great job - the location of Prelude has been added to the SYSTEM LIST! However, it has not yet been discovered. A body can be discovered by [color=yellow]seeing it up close[/color].

To discover Prelude, press on '???' on the SYSTEM LIST to lock, and then press the 'ORBIT' action in the ACTIONS PANEL.
[img]res://graphics/system-map/actions-panel/orbit_icon.png[/img]"

[node name="tutorialFollowPrelude" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialFollowPrelude"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/tabs_and_ca_scroll/tabs_actions_scroll/tabs/OVERVIEW")
info = "Amazing effort! We have discovered Prelude and gained 514 nanites in value from doing so. [color=yellow]However, there is still another way to gain value from it...[/color]

The question mark next to Prelude on the SYSTEM LIST shows an undocumented anomaly. All anomalies can result in rewards or tragedy. Investigating an anomaly requires interacting with it.

To investigate the anomaly on Prelude, press on 'Prelude' on the SYSTEM LIST to lock, and then press the 'GO-TO' action in the ACTIONS PANEL.
[img]res://graphics/system-map/actions-panel/go_to_icon.png[/img]"

[node name="tutorialMarkIngress" parent="." instance=ExtResource("2_k3c6j")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 72.0
video_file = "res://graphics/system-map/tutorial/tutorialMarkIngress.ogv"
video_aspect_ratio = 2.0
target_objective_wID = "tutorialMarkIngress"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/scopes_snap_scroll/core_and_value_scroll/core/core_scroll/core_panel/core_margin/core_scroll/barycenter_container")
track_offset = Vector2(0, -355)
background_alpha = 1.0
info = "You did it!

The SYSTEM LIST currently underlines a missing body named Ingress situated further than Prelude. [color=yellow]Our value is maximised by discovering all bodies within a star system[/color]. Let's mark Ingress!

To learn the [i]direction[/i] to ping Ingress, the BARYCENTER VISUALIZER should be used. It displays the [color=yellow]direction[/color] to other bodies [color=yellow]from the locked body[/color] with a [color=yellow]dot[/color]. Dark red dots are beyond the current scan arc.

To ping Ingress, press on 'Prelude' on the SYSTEM LIST to lock, adjust the LIDAR direction so it matches the direction of the dot which is oscillating, and press the 'PING!' button.
[img=150%x75%]res://graphics/objective/tutorial_barycenter_example.png[/img]"

