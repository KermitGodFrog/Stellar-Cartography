[node name="tutorialDiscoverPrelude" parent="." instance=ExtResource("2_k3c6j")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 72.0
video_file = "res://graphics/system-map/tutorial/tutorialDiscoverPrelude.ogv"
video_title_text = "Discover Prelude by seeing it up close. Use the ‘ORBIT’ action to get close."
video_aspect_ratio = 2.1
start_on_video = true
target_objective_wID = "tutorialDiscoverPrelude"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/tabs_and_ca_scroll/tabs_actions_scroll/actions_panel")
track_offset = Vector2(0, -300)
info = "Great job - the location of Prelude has been added to the SYSTEM LIST! However, it has not yet been discovered. A body can be discovered by [color=yellow]seeing it up close[/color].

To discover Prelude, press on '???' on the SYSTEM LIST to lock, and then press the 'ORBIT' action in the ACTIONS PANEL.
[img]res://graphics/system-map/actions-panel/orbit_icon.png[/img]"

