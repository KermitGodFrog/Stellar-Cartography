[node name="tutorialFollowIngress" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialFollowIngress"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/tabs_and_ca_scroll/tabs_actions_scroll/tabs/OVERVIEW")
info = "Excellent work!

Wormholes like Ingress are how you progress in [i]Stellar Cartographer[/i]. When all bodies are discovered, or a star system is too dangerous, find a wormhole to take you to the next star system. [color=yellow]Traversing a wormhole requires interacting with it[/color].

To traverse Ingress, press on 'Ingress' on the SYSTEM LIST to lock, and then press the 'GO-TO' action in the ACTIONS PANEL. 
[img]res://graphics/system-map/actions-panel/go_to_icon.png[/img]"

[node name="tutorialOptionalUnderstandUnits" parent="." instance=ExtResource("5_ry3io")]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -120.0
offset_top = -275.0
offset_right = 120.0
offset_bottom = -177.0
grow_horizontal = 2
grow_vertical = 2
video_file = "res://graphics/system-map/tutorial/tutorialOptionalUnderstandUnits.ogv"
video_title_text = "Avoid the marauder by making it exit your 'SCANNER PROFILE' (brown inner circle) and then discover Ingress while avoiding redetection."
video_aspect_ratio = 2.4
start_on_video = true
flash_switch_button_until_pressed = true
target_objective_wID = "tutorialOptionalUnderstandUnits"
text_box_size = Vector2(500, 0)
info = "Oh no - a marauder ship has appeared within your 'SCANNER PROFILE'! It will steal your technology if it catches you on the SYSTEM MAP. You must evade it!
[img]res://graphics/objective/tutorial_hostile_unit_example.png[/img]
Units are [color=yellow]bodies that move on their own terms[/color] - like ships. Units within your ship's 'SCANNER POWER' (dotted grey outer circle) are appended to the CONTACT LIST. Units within your ship's 'SCANNER PROFILE' (brown inner circle) [color=yellow]can see your ship and respond to its presence[/color].

To evade the marauder, right click [[img=2em2em]graphics/shared/mouse/mouse_right.png[/img]] to travel to your mouse pointer and hold $SC_BOOST to boost - [color=yellow]lead your starship away from the marauder so that it exits your 'SCANNER PROFILE'[/color], and then discover Ingress while avoiding redetection."

