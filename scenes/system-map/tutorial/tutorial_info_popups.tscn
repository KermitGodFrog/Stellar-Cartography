[node name="tutorialFollowIngress" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialFollowIngress"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/tabs_and_ca_scroll/tabs/OVERVIEW")
info = "[i] * As soon as all activities in a star system are exhausted, it becomes time to travel to the next one.[/i]

Wormholes allow for travel between star systems. Traversing a wormhole requires interacting with it.

Click on Ingress on the SYSTEM LIST to lock, and then press the 'GO-TO' action in the ACTIONS PANEL. Wormholes, space stations, planetary anomalies, and other phenomena are all interacted with through the 'GO-TO' action.
[img]res://graphics/system-map/actions-panel/go_to_icon.png[/img]"

[node name="tutorialOptionalStunMarauder" parent="." instance=ExtResource("1_fpin1")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 66.0
target_objective_wID = "tutorialOptionalStunMarauder"
text_box_size = Vector2(250, 100)
track = NodePath("../../control/scopes_snap_scroll/scopes_bg/scopes_margin/scopes_container")
track_offset = Vector2(0, 40)
info = "Stunning a hostile (red) unit stops it from chasing you temporarily. Adjust your LIDAR direction so it matches the direction of the marauder on the SYSTEM MAP and press the 'PING' button.
[i] * The smaller the scan arc, the longer a hostile unit stays stunned.[/i]"

[node name="tutorialOptionalUnderstandUnits" parent="." instance=ExtResource("1_fpin1")]
