info = "Check your 'HULL STRESS' status in the STATUS PANEL. To do this, [color=yellow]view the tooltip for entries in the STATUS PANEL by hovering over them.[/color]
[img]graphics/system-map/status-panel/hull_stress_icon.png[/img]"
