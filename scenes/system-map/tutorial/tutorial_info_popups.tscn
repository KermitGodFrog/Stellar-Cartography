[node name="tutorialMarkPrelude" parent="." instance=ExtResource("2_7r03o")]
visible = false
layout_mode = 0
target_objective_wID = "tutorialMarkPrelude"
text_box_size = Vector2(300, 100)
track = NodePath("../../control/scopes_snap_scroll/core_and_value_scroll/core_panel_bg/core_panel_scroll/core_panel/core_margin/core_scroll/sonar_container")
track_offset = Vector2(0, -300)
info = "A planet named Prelude is situated in low orbit around a nearby M-Class star named King.

Mark a body by pinging it three times. Adjust the LIDAR scan direction so it points towards the star by clicking, set the arc to its maximum with the slider, and press the ‘PING’ button.
[i] * Marking a body establishes its location on the SYSTEM LIST. It is usually necessary to mark a body before discovering it.[/i]
[img=75%x75%]res://graphics/objective/tutorial_LIDAR_example.png[/img]"

[node name="tutorialOptionalScopeMode" parent="." instance=ExtResource("1_fpin1")]
visible = false
layout_mode = 0
offset_right = 240.0
offset_bottom = 66.0
target_objective_wID = "tutorialOptionalScopeMode"
text_box_size = Vector2(250, 100)
track = NodePath("../../control/scopes_snap_scroll/scopes_bg/scopes_margin/scopes_container")
track_offset = Vector2(-307, 0)
info = "Press the 'RAD' button on SCOPES (or press $SC_SCOPE_SWITCH) to switch the scope mode. Depending on the scope mode, different bodies can be discovered. 
[i] * 'RAD' enabled -> small bodies discoverable. 'RAD' disabled -> large bodies (like planets) discoverable. [/i]"

[node name="tutorialOptionalZoomScopes" parent="." instance=ExtResource("2_7r03o")]
