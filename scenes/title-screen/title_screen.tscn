[node name="description" type="Label" parent="margin/split/right_scroll/changelog_panel/changelog_margin/changelog_scroll/description_scroll/description_vbox"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
text = "- Added new music: three themes, one ambience track, three dialogue tracks, and two short tracks played on player death/win. 
- Added three new special anomalies; finished implementing one existing special anomaly.
- Made planets without moons still considered for 'secondary' satellite generation, e.g. wormholes, rendezvous points, etc.
- Added 12 new upgrades.
- Implemented a requirements and incompatibilities system for upgrades - some upgrades now require others to be unlocked before themselves, or can't be unlocked when others are unlocked.
- Updated upgrade generation - upgrades that require others which are already unlocked are prioritised.
- Upgrade descriptions are now viewed via tooltip, instead of being integrated into station UI.
- Minor fixes to the Gas Layer Surveyor (GLS) module.
- Gave rare planets a special frame on the system list.
- All habitable planets are now guaranteed to have a planetary anomaly.
- Added seven new rare planets to the generation pool.
- Stars and certain planet types now visibly glow on scopes.
- Added five new planetary anomalies (two complex); added three new space anomalies.
- Added special interactions for three station classifications.
- The scopes zoom level is now shown via a progress bar.
- Updated the journey map app: added scroll extents, automatic scrolling to current star system on popup, a progress bar to show scroll proportion, and a parallax star background.
- A 'star infographic panel' is now shown on the system list 'INFO' tab when viewing a star or wormhole.
- Rendezvous point overhaul.
- - Implemented the ability to exchange XP between characters.
- - The player can now talk to their senior staff (can only ask four questions at the moment).
- - Added a few extra flairs for senior staff entering the player's ready room, which are randomly selected from.
- - Added descriptions for each character's appearance when they are called to the player's ready room for the first time.
- Most UI elements now use the same theme.
- Overhauled the appearance of the stats menu.
- Creating a new game is now facilitated by a 'create menu', which allows for the selection of mutations and difficulty customisation.
- Added 15 new mutations.
- Installed mutations are now displayed when the game is paused.
- In the history popup, the item for a run now displays the mutations installed for that run.
- Special systems, special anomalies and system hazards are now subject to requirements before being added to the generation pool for each star system.
- Added three new special systems.
- Made all fonts use MSDF rendering.
- Implemented the ability to change resolution, window mode, dialogue text size, dialogue line spacing and dialogue BG color in settings.
- Overhauled the achievements system: added hidden-before-unlock achievements, support for multiple trophy textures, a progress bar, and graceful handling of achievements being updated, removed or added in future updates, without any data loss.
- Some planets are inhabited by humankind, which is shown via a new frame on the system list. If these planets are not in a civilized system, they are guaranteed to have a planetary anomaly which ends up being a settlement.
- Added two new ship encounters.
- Added a title screen.
- Updated the credits popup on the main menu.
- Overhauled three planetary and three space anomalies with branching paths depending on what upgrades the player has unlocked.
- Added 22 new achievements.
- Improved the player death dialogue message.
- Added three new entering system dangers (ESDs). 
- The system map camera position is now reset to the player's position on wormhole traversal.
- Improvements to the final challenge: dialogue changes and additions, new illustrations, and a custom naming scheme for the entire star system.
- Implemented new star panoramas into scopes, long range scopes and the wormhole traversal minigame.
- Improved the outpost/settlement dialogue messages.
- Updated the intro theme song with an improved version."
autowrap_mode = 3
