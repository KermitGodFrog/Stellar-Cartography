[resource]
script = ExtResource("1_vf8fj")
title = "Go-to Prelude"
description = "The question mark next to Prelude on the SYSTEM LIST shows an undocumented anomaly. All anomalies can result in rewards or tragedy. Investigating an anomaly requires interacting with it.
To investigate the anomaly on Prelude, press on 'Prelude' on the SYSTEM LIST to lock, and then press the 'GO-TO' action in the ACTIONS PANEL.
[img]res://graphics/system-map/actions-panel/go_to_icon.png[/img]"
