[resource]
script = ExtResource("1_di0mm")
title = "Go-to & Enter Ingress"
description = "Wormholes like Ingress are how you progress in [i]Stellar Cartographer[/i]. When all bodies are discovered, or a star system is too dangerous, find a wormhole to take you to the next star system. Traversing a wormhole requires interacting with it.
To traverse Ingress, press on 'Ingress' on the SYSTEM LIST to lock, and then press the 'GO-TO' action in the ACTIONS PANEL. 
[img]res://graphics/system-map/actions-panel/go_to_icon.png[/img]"
