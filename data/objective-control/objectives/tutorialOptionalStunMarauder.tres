script = ExtResource("1_ovg2v")
title = "(Optional) Stun the Marauder"
description = "Stunning a hostile (red) unit stops it from chasing you temporarily. Adjust your LIDAR direction so it matches the direction of the marauder on the SYSTEM MAP and press the 'PING' button."
