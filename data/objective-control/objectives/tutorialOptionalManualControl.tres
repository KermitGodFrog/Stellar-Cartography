script = ExtResource("1_dssi5")
title = "(Optional) Set Course Manually"
description = "On the SYSTEM MAP, right click to travel to your mouse pointer.
* [i]Left click to direct SCOPES towards your mouse pointer.[/i]
* [i]Right click on a body to quick orbit.[/i]
* [i]Left click on a body to quick lock.[/i]"
