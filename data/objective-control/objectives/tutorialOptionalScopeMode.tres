[ext_resource type="Script" uid="uid://cxmuiuh6uokvl" path="res://data/objective-control/objectiveAPI.gd" id="1_lie2m"]

[resource]
script = ExtResource("1_lie2m")
title = "(Optional) Change Scope Mode"
description = "Press the 'RAD' button on SCOPES or $SC_SCOPE_SWITCH to switch the scope mode. Depending on the scope mode, different kinds of bodies can be discovered.
* [i]'RAD' enabled -> small bodies discoverable.[/i]
* [i]'RAD' disabled -> large bodies (like planets) discoverable.[/i]"
metadata/_custom_type_script = "uid://cxmuiuh6uokvl"
